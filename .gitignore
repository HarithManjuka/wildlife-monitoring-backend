# ==============================================================================
# Wildlife Monitoring Backend - Professional .gitignore
# ==============================================================================

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Environment Variables & Sensitive Credentials
# Keep credentials local and out of version control
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime, PIDs, and Seed Data
pids/
*.pid
*.seed
*.pid.lock

# Test Coverage and Artifacts
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# Build and Transpilation Output
dist/
build/
bin/
*.tsbuildinfo

# Caches and Temporary Files
.cache/
.eslintcache
.oxlintcache
tmp/
temp/
.npm
.node_repl_history

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor Directories
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Package Manager Specific
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
