# ==============================================================================
# Smart Wildlife Conservation System - Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
# Dedicated unique port chosen to avoid conflicts with 3000, 5000, 5173, 8000, 8080
PORT=7050
NODE_ENV=development

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/wildlife_monitoring
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wildlife_monitoring?retryWrites=true&w=majority
# Note: If your password contains special characters like #, @, %, percent-encode them (e.g., '#' is '%23')
MONGODB_URI=mongodb://127.0.0.1:27017/wildlife_monitoring

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration (Allows frontend operations portal)
CORS_ORIGIN=http://localhost:7051

# Operational Module Flags & Thresholds
PATROL_OFFLINE_SYNC_MAX_BATCH=50
GEOFENCE_ALERT_PROXIMITY_KM=2.5
SMS_CONFLICT_AUTO_TRIAGE=true
